# Required source wallet. Intentionally blank so copied examples fail closed.
HLCT_SOURCE_WALLET=

# Runtime mode: shadow, paper, testnet, live.
HLCT_MODE=shadow
# Read-only source network: mode, mainnet, or testnet.
# Use mainnet with testnet mode when observing a real active trader while executing on testnet.
HLCT_SOURCE_NETWORK=mode
# Unified-source DEX scope. strict blocks any active non-default DEX. The explicit
# default_only_account_equity option copies default-perp positions only while using
# total shared Unified collateral as the sizing denominator and reporting reduced fidelity.
HLCT_SOURCE_DEX_SCOPE=strict
# Shadow/paper may use this local default. Testnet/live require an absolute durable path.
HLCT_DB_PATH=data/copytrader.sqlite3
HLCT_ALLOWED_SYMBOLS=BTC,ETH,SOL
HLCT_FIXED_MULTIPLIER=0.10
# Automatic sizing scales by fresh follower/source accountValue, then applies
# HLCT_FIXED_MULTIPLIER. HLCT_EQUITY_RATIO is an explicit override when set.
# HLCT_SIZING_EQUITY_CAP_USD optionally caps the follower accountValue used in
# that ratio. The slot supervisor sets it from fixed_risk_budget_usd and fails
# closed if that policy value is missing, non-finite, or non-positive.
HLCT_BALANCE_SIZING_ENABLE=true
HLCT_SIZING_EQUITY_CAP_USD=
HLCT_MAX_BALANCE_SCALE=1
HLCT_EQUITY_RATIO=
HLCT_MAX_NOTIONAL_USD=250
HLCT_MAX_GROSS_EXPOSURE_USD=1000
HLCT_MAX_OPEN_POSITIONS=20
HLCT_MAX_LEVERAGE=3
HLCT_MIN_ORDER_SIZE=0.0001
HLCT_SLIPPAGE_BPS=20
HLCT_CLOSE_SLIPPAGE_BPS=300
HLCT_HIP3_ORACLE_ENVELOPE_BPS=100
HLCT_STALE_SOURCE_MS=10000
HLCT_STALE_FOLLOWER_MS=10000
HLCT_RAPID_FLIP_MS=1500
# Testnet/live require an absolute durable path so changing the working directory cannot bypass it.
HLCT_KILL_SWITCH_PATH=data/KILL_SWITCH
HLCT_MAX_NEW_INTENTS_PER_CYCLE=10
HLCT_MAX_OPEN_INTENTS=20
HLCT_MAX_EXCHANGE_ACTIONS_PER_MINUTE=30
# Shared weighted Hyperliquid REST budget across local processes and both official networks.
# Leave blank for the stable user-local default outside the repository/sync folder.
HLCT_REST_THROTTLE_PATH=
HLCT_REST_THROTTLE_ALL=
HLCT_REST_THROTTLE_HOSTS=
HLCT_REST_WEIGHT_INTERVAL_MS=60
HLCT_REST_THROTTLE_MAX_WAIT_MS=60000
HLCT_REST_THROTTLE_LOCK_TIMEOUT_MS=30000
HLCT_REST_RETRY_ATTEMPTS=5
HLCT_REST_RETRY_BACKOFF_MS=3000
# Pilot-only external throttle evidence is accepted only from the exact parent
# process environment. Never add an active HLCT_EXTERNAL_THROTTLE_ATTESTATION
# assignment to this file or another dotenv file. For the current externally
# shaped connection, set the exact PowerShell value documented in DEPLOYMENT.md
# before measurement, benchmark, preview, and launch.
HLCT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
HLCT_CIRCUIT_BREAKER_COOLDOWN_MS=60000
HLCT_EXCHANGE_ACTION_TIMEOUT_S=15
HLCT_EXCHANGE_EXPIRES_AFTER_MS=10000
HLCT_DEAD_MAN_CANCEL_MS=30000
# Exchange-hosted scheduleCancel is preferred when the action account is eligible. Fresh
# zero-volume mainnet followers use an independently supervised watchdog fallback.
HLCT_DEAD_MAN_POLICY=exchange_required
HLCT_CONTAINMENT_WATCHDOG_TTL_MS=15000

# These are general shadow/testnet defaults, not the isolated mainnet-canary profile.
# The canary must override them in an ignored local environment: one BTC or ETH symbol,
# $12-$15 max notional/gross, 1x, one new/open intent, 6-12 actions/minute,
# circuit-breaker threshold 1, a 60-120 second containment deadline, and $15-$55 total
# follower account value verified at readiness and immediately before send. See docs/MAINNET_CANARY.md.
HLCT_AUTH_PROBE_INTERVAL_MS=600000
HLCT_INFO_TIMEOUT_S=10
# Required by `hl-copytrader serve` and must contain at least 16 characters because that process
# exposes the fleet preview/start controller. `console` may omit it for direct loopback-only use.
# Direct non-loopback binds are refused. Do not publish/proxy fleet preview, start, or emergency
# containment; those controls are for a direct literal-loopback browser only.
HLCT_GUI_TOKEN=
HLCT_RUNTIME_LEASE_TTL_MS=30000
# Optional absolute override. Default is a stable user-local runtime-lock directory shared
# across checkouts and supervisor run directories.
HLCT_RUNTIME_LOCK_DIR=
HLCT_DASHBOARD_CONTROL_MAX_PER_MINUTE=20
HLCT_DASHBOARD_SECURITY_AUDIT_TTL_MS=15000
HLCT_SOURCE_REACTION_QUEUE_SIZE=100
HLCT_SOURCE_WEBSOCKET_IDLE_TIMEOUT_MS=55000
HLCT_SOURCE_WEBSOCKET_HEARTBEAT_TIMEOUT_MS=5000
HLCT_SOURCE_WEBSOCKET_RECONNECT_ATTEMPTS=3
HLCT_SOURCE_WEBSOCKET_RECONNECT_BACKOFF_MS=1000
HLCT_CONNECTION_SIREN_AFTER_MS=30000

# Gap recovery for source fills and TWAP slice fills.
HLCT_SOURCE_FILL_BACKFILL_LOOKBACK_MS=300000
HLCT_SOURCE_FILL_BACKFILL_OVERLAP_MS=5000
HLCT_SOURCE_FILL_BACKFILL_MAX_PAGES=5

# Public read-only dashboard analytics. The leaderboard is fetched asynchronously by the GUI.
HLCT_LEADERBOARD_ENABLE=true
HLCT_LEADERBOARD_URL=https://stats-data.hyperliquid.xyz/Mainnet/leaderboard
HLCT_LEADERBOARD_CACHE_TTL_MS=300000
HLCT_LEADERBOARD_TIMEOUT_S=8
HLCT_LEADERBOARD_MIN_VOLUME_USD=100000
HLCT_LEADERBOARD_MIN_ACCOUNT_VALUE_USD=2000
HLCT_LEADERBOARD_LIMIT=100

# Public read-only address analyzer for compact fills, PnL, drawdown, and asset activity.
HLCT_ADDRESS_ANALYTICS_ENABLE=true
HLCT_ADDRESS_ANALYTICS_URL=https://api.hyperliquid.xyz
HLCT_ADDRESS_ANALYTICS_CACHE_TTL_MS=120000
HLCT_ADDRESS_ANALYTICS_TIMEOUT_S=6
HLCT_ADDRESS_ANALYTICS_WINDOW_DAYS=30
HLCT_ADDRESS_ANALYTICS_MAX_PAGES=12

# Frozen reviewed fleet declarations, not tuning knobs. `serve` forces fast mode on and
# rejects any value that differs from windows-fast-runtime-v2. Mainnet still starts only
# through the authenticated UI; queue bounds not listed here are fixed in the same policy.
HLCT_FAST_EXECUTION_ENABLE=false
HLCT_DEFERRED_DELTA_WINDOW_MS=300000
HLCT_DEFERRED_SCHEDULER_BOUND_MS=100
HLCT_AFFECTED_FOLLOWER_FRESHNESS_MS=5000
HLCT_FULL_FOLLOWER_AUDIT_MS=60000
HLCT_MARKET_CATALOG_REFRESH_MS=60000
HLCT_SOURCE_SHARD_COUNT=2
HLCT_ACTION_SHARD_COUNT=2
HLCT_MARKET_DATA_CONNECTION_COUNT=1
HLCT_MARKET_EVENT_QUEUE_SIZE=4096
HLCT_ACTION_QUEUE_SIZE=256
HLCT_WEBSOCKET_HEARTBEAT_MS=30000
HLCT_WEBSOCKET_RECONNECT_MIN_MS=250
HLCT_WEBSOCKET_RECONNECT_MAX_MS=5000
HLCT_WEBSOCKET_CONNECTION_LIMIT=10
HLCT_WEBSOCKET_OVERLAP_LIMIT=8
HLCT_WEBSOCKET_SUBSCRIPTION_LIMIT=1000
HLCT_WEBSOCKET_UNIQUE_USER_LIMIT=10
HLCT_WEBSOCKET_OUTBOUND_PER_MINUTE=2000
HLCT_WEBSOCKET_INFLIGHT_POST_LIMIT=100
HLCT_REST_ORDINARY_WEIGHT_PER_MINUTE=720
HLCT_REST_RESERVE_WEIGHT_PER_MINUTE=480
HLCT_CLOCK_MAX_SKEW_MS=500
HLCT_CLOCK_MAX_JUMP_MS=500
HLCT_DIRECT_SOURCE_MAX_AGE_MS=5000
HLCT_PRIMARY_CLEANUP_TIMEOUT_MS=1800000
HLCT_CATALOG_POLICY_VERSION=dynamic-all-active-v1

# Planned manual source-to-subaccount rows shown in the GUI monitor. Enabled testnet/live
# rows must be verified and match the current source plus follower/vault action account.
# A single process consumes exactly one verified assignment. For simultaneous testnet slots,
# validate a slot plan and run scripts/run_slot_supervisor.py.
HLCT_SUBACCOUNT_ASSIGNMENTS_JSON=

# Follower account. The account address is the master/subaccount/vault address to query.
# The API wallet private key signs actions. Never query state with the API wallet address.
# Public signer address. Required in live and strongly recommended in testnet; runtime also proves
# the derived signer is an active API wallet approved for the configured action account/owner.
HLCT_API_WALLET_ADDRESS=
# If HLCT_VAULT_ADDRESS is set, it must match HLCT_FOLLOWER_ACCOUNT_ADDRESS so
# signed actions and reconciliation target the same vault/subaccount.
HLCT_FOLLOWER_ACCOUNT_ADDRESS=
# auto accepts either fully validated Standard or Unified state. Supervisors set an explicit
# per-slot standard/unified expectation so an exchange-side mode change fails closed.
HLCT_EXPECTED_ACCOUNT_MODE=auto
HLCT_API_PRIVATE_KEY=
# Optional alternative: put only the private key in this ignored local file.
# HLCT_API_PRIVATE_KEY takes precedence if both are set.
HLCT_API_PRIVATE_KEY_FILE=
# Testnet only. Leave false when using a dedicated approved API wallet (recommended).
# Mainnet/live always rejects a master/private trading-account key even if this is true.
HLCT_ALLOW_MASTER_PRIVATE_KEY=false
HLCT_VAULT_ADDRESS=

# These two flags admit only the dedicated mainnet-canary commands when the strict profile passes.
# Leave both false by default. Enabling them is not fleet or production approval.
HLCT_LIVE_ENABLE=false
HLCT_CONFIRM_MAINNET_LIVE=false
# Separate opt-in for the legacy generic live run/follow path. Keep false for the fleet runtime;
# multi-slot mainnet starts only through the authenticated fleet UI and its measured shared topology.
HLCT_LIVE_COPY_ENABLE=false

# Local GUI. Direct non-loopback binding is intentionally unsupported.
HLCT_HOST=127.0.0.1
HLCT_PORT=8080
